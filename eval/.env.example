# Judge evaluation config.
# Copy this file to `.env` in the same folder and fill in your own values.
# `.env` is gitignored and must never be committed — this example is the file we ship.

# OpenAI-compatible endpoint. Default: a local 9router gateway on port 20128.
BASE_URL=http://127.0.0.1:20128/v1

# Model alias passed to the gateway (http backend). 9router resolves it upstream.
MODEL=stacks

# API key for BASE_URL. Any OpenAI-compatible key works.
API_KEY=sk-replace-me

# Model used by `--backend cli` (runs `claude -p --model <name>`).
CLI_MODEL=sonnet

# Optional run knobs.
TIMEOUT=90
WORKERS=4
